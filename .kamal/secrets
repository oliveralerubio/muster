# Kamal secrets (dotenv). NO VALUE LIVES IN THIS REPOSITORY.
#
# Every key is read from one gha-only file on the host
# (${MUSTER_CLOUD_SECRETS_FILE:-/etc/muster-cloud/kamal.env}) by a tiny helper
# that prints exactly one value and fails loudly when it is missing.
# The helper path is relative to the repository root, which bin/kamal mounts
# as the working directory.

# There is no registry secret: the image is public and Kamal never logs in
# (config/deploy.yml, `registry`).

MUSTER_DATABASE_URL=$(deploy/kamal/secret MUSTER_DATABASE_URL)
MUSTER_OIDC_ISSUER=$(deploy/kamal/secret MUSTER_OIDC_ISSUER)
MUSTER_OIDC_CLIENT_ID=$(deploy/kamal/secret MUSTER_OIDC_CLIENT_ID)
MUSTER_OIDC_CLIENT_SECRET=$(deploy/kamal/secret MUSTER_OIDC_CLIENT_SECRET)
MUSTER_PADDLE_API_KEY=$(deploy/kamal/secret MUSTER_PADDLE_API_KEY)
MUSTER_PADDLE_WEBHOOK_SECRET=$(deploy/kamal/secret MUSTER_PADDLE_WEBHOOK_SECRET)
POSTGRES_PASSWORD=$(deploy/kamal/secret POSTGRES_PASSWORD)
