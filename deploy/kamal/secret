#!/bin/sh
# deploy/kamal/secret KEY — print exactly one secret value, nothing else.
#
# Called by .kamal/secrets (Kamal runs it inside the pinned Kamal container,
# an Alpine image: POSIX sh only, no bash). The values live in ONE file on the
# host, never in the repository:
#
#   ${MUSTER_CLOUD_SECRETS_FILE:-/etc/muster-cloud/kamal.env}
#
# The file is parsed, never sourced: one KEY=VALUE per line, comments (#) and
# blank lines allowed, no multi-line values, no shell expansion. One pair of
# surrounding single or double quotes is removed. A value is printed without a
# trailing newline. Fails loudly (exit 1, message on stderr that never contains
# a value) when the file is missing or readable by other users, or the key is
# missing, empty or defined twice. The one exception: an EMPTY value is allowed
# for keys starting with MUSTER_PADDLE_ (nothing is printed, exit 0); writing
# `MUSTER_PADDLE_API_KEY=` explicitly is how the operator says "billing off".
# A missing key still fails for every key.

set -eu

fail() {
  printf 'deploy/kamal/secret: %s\n' "$1" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "usage: secret KEY"
key=$1
case $key in
  '' | *[!A-Za-z0-9_]*) fail "invalid key name" ;;
esac

file=${MUSTER_CLOUD_SECRETS_FILE:-/etc/muster-cloud/kamal.env}
[ -f "$file" ] || fail "secrets file not found: $file"
[ -r "$file" ] || fail "secrets file is not readable by this user: $file"
mode=$(stat -c %a -- "$file") || fail "cannot stat $file"
# No access at all for "other" (the last octal digit).
case $mode in
  *[0-7]) [ $((0$mode & 7)) -eq 0 ] || fail "$file must not be accessible to other users (mode $mode)" ;;
  *) fail "unexpected mode for $file" ;;
esac

count=0
value=
while IFS= read -r line || [ -n "$line" ]; do
  case $line in
    "$key="*)
      count=$((count + 1))
      value=${line#*=}
      ;;
  esac
done <"$file"

[ "$count" -ne 0 ] || fail "key $key not found in $file"
[ "$count" -eq 1 ] || fail "key $key is defined more than once in $file"

case $value in
  \"*\") value=${value#\"}; value=${value%\"} ;;
  \'*\') value=${value#\'}; value=${value%\'} ;;
esac
if [ -z "$value" ]; then
  case $key in
    MUSTER_PADDLE_*) exit 0 ;;
    *) fail "key $key is empty in $file" ;;
  esac
fi

printf '%s' "$value"
