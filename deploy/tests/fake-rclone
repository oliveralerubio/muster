#!/usr/bin/env python3
# A fake rclone for deploy/tests/*.sh: a "remote" is a plain directory path.
# Supports copy (--files-from-raw), copyto, purge, lsjson, lsf, size and cat, and logs
# every call to $FAKE_RCLONE_LOG. Failure injection (environment):
#   FAKE_RCLONE_FULL=1       copy and copyto fail (Drive's storage quota is full)
#   FAKE_RCLONE_LS_FAIL=1    lsjson fails (Drive cannot be listed)
#   FAKE_RCLONE_NO_HASH=1    lsjson reports no hashes
#   FAKE_RCLONE_PURGE_FAIL=ID purge of that snapshot deletes its db artifact, then fails
#   FAKE_RCLONE_SIZE_BYTES=N `size --json` reports N bytes
import hashlib, json, os, shutil, sys

args = sys.argv[1:]
log = os.environ.get("FAKE_RCLONE_LOG")
if log:
    with open(log, "a") as handle:
        handle.write(" ".join(args) + "\n")
WITH_VALUE = {"--files-from-raw", "--contimeout", "--timeout", "--retries",
              "--low-level-retries", "--stats", "--log-level", "--transfers", "--checkers", "--include"}
flags, pos, i = {}, [], 1
while i < len(args):
    a = args[i]
    if a in WITH_VALUE:
        flags[a] = args[i + 1]
        i += 2
    elif a.startswith("--"):
        flags[a] = True
        i += 1
    else:
        pos.append(a)
        i += 1
cmd = args[0]
if cmd == "copy":
    if os.environ.get("FAKE_RCLONE_FULL"):
        print("fake rclone: googleapi: Error 403: The user's Drive storage quota has been exceeded.", file=sys.stderr)
        sys.exit(1)
    src, dst = pos
    with open(flags["--files-from-raw"]) as handle:
        names = [line.rstrip("\n") for line in handle if line.strip()]
    for name in names:
        target = os.path.join(dst, name)
        if "--ignore-existing" in flags and os.path.exists(target):
            continue
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copyfile(os.path.join(src, name), target)
elif cmd == "purge":
    broken = os.environ.get("FAKE_RCLONE_PURGE_FAIL")
    if broken and pos[0].rstrip("/").endswith("/" + broken):
        for name in sorted(os.listdir(pos[0])):
            if name.startswith("db."):
                os.remove(os.path.join(pos[0], name))
        print("fake rclone: purge interrupted", file=sys.stderr)
        sys.exit(1)
    if not os.path.isdir(pos[0]):
        sys.exit(3)
    shutil.rmtree(pos[0])
elif cmd == "lsjson":
    root = pos[0]
    if os.environ.get("FAKE_RCLONE_LS_FAIL"):
        print("fake rclone: couldn't list the remote: connection refused", file=sys.stderr)
        sys.exit(1)
    if not os.path.isdir(root):
        sys.exit(3)
    out = []
    for base, _dirs, files in os.walk(root):
        for name in files:
            path = os.path.join(base, name)
            entry = {"Path": os.path.relpath(path, root), "Name": name,
                     "Size": os.path.getsize(path), "IsDir": False}
            if "--hash" in flags and not os.environ.get("FAKE_RCLONE_NO_HASH"):
                with open(path, "rb") as handle:
                    entry["Hashes"] = {"sha256": hashlib.sha256(handle.read()).hexdigest()}
            out.append(entry)
    print(json.dumps(out))
elif cmd == "lsf":
    root = pos[0]
    if not os.path.isdir(root):
        sys.exit(3)
    if "--recursive" in flags:
        found = []
        for base, _dirs, files in os.walk(root):
            for name in files:
                rel = os.path.relpath(os.path.join(base, name), root)
                if "--include" not in flags or name == flags["--include"] or rel == flags["--include"]:
                    found.append(rel)
        print("\n".join(sorted(found)))
    else:
        for name in sorted(os.listdir(root)):
            if not (os.path.isdir(os.path.join(root, name)) and "--files-only" in flags):
                print(name)
elif cmd == "size":
    root = pos[0]
    total = sum(os.path.getsize(os.path.join(b, n)) for b, _d, fs in os.walk(root) for n in fs)
    total = int(os.environ.get("FAKE_RCLONE_SIZE_BYTES", total))
    print(json.dumps({"count": 1, "bytes": total}))
elif cmd == "copyto":
    if os.environ.get("FAKE_RCLONE_FULL"):
        print("fake rclone: googleapi: Error 403: The user's Drive storage quota has been exceeded.", file=sys.stderr)
        sys.exit(1)
    src, dst = pos
    if "--immutable" in flags and os.path.exists(dst):
        print("fake rclone: source and destination exist but do not match: immutable file modified", file=sys.stderr)
        sys.exit(1)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
elif cmd == "cat":
    if not os.path.isfile(pos[0]):
        sys.exit(3)
    with open(pos[0], "rb") as handle:
        sys.stdout.buffer.write(handle.read())
else:
    print("fake rclone: unsupported command " + cmd, file=sys.stderr)
    sys.exit(2)
