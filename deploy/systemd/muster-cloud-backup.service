# Staged by deploy/install-systemd.sh; never installed by CI.
[Unit]
Description=Muster Cloud: snapshot-bound encrypted backup
Documentation=file:///opt/muster-cloud/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=muster-cloud
Group=muster-cloud
EnvironmentFile=/etc/muster-cloud/ops.env
ExecStart=@BIN@ backup run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=@WRITABLE@
