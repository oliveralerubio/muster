# Installed by deploy/kamal/host-setup.sh (never by CI).
[Unit]
Description=Muster Cloud: offsite copy of published backup snapshots (Google Drive)
Documentation=file:///opt/muster-cloud/deploy/KAMAL.md
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/srv/muster-cloud/backups/snapshots
OnFailure=muster-cloud-alert@%n.service

[Service]
Type=oneshot
# rclone's own config (the Drive remote and its refreshed OAuth token) is root's.
User=root
Group=root
Environment=RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=RCLONE_CACHE_DIR=/var/cache/muster-cloud-offsite
CacheDirectory=muster-cloud-offsite
# `rclone copy` only, never `sync`: an upload deletes nothing. The one script
# also applies the deletions that retention recorded in its audit records
# (validated ids, absent locally, at most 100 per run, no Drive trash). See the
# header of /usr/local/sbin/muster-cloud-offsite. ONLY the published
# snapshots/ directory is sent, never staging/, ops/, trash/ or audit/.
ExecStart=/usr/local/sbin/muster-cloud-offsite
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# /root stays readable for rclone.conf; only its rclone directory is writable
# (OAuth token refresh rewrites the config file). The script keeps its state in
# /var/lib/muster-cloud/offsite.
ProtectHome=read-only
ReadWritePaths=/root/.config/rclone /var/lib/muster-cloud/offsite
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
